# Copy this line into .env and replace the placeholders with the Supabase
# PostgreSQL pooler connection details from Project Settings > Database.
DATABASE_URL=postgresql://postgres.<PROJECT_REF>:<DATABASE_PASSWORD>@<POOLER_HOST>:6543/postgres?sslmode=require

# Flutterwave test credentials. Keep the secret key server-side.
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-your-key
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-your-key
FLUTTERWAVE_BASE_URL=https://api.flutterwave.com
FLUTTERWAVE_REDIRECT_URL=https://your-domain.com/api/payments/flutterwave/redirect/